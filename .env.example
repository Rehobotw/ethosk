# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# The VITE_-prefixed values are the only ones exposed to the browser bundle.
# Both keys come from Project Settings -> API Keys in the Supabase dashboard.
VITE_SUPABASE_URL=
# Labelled "publishable key" (or legacy "anon key") in the dashboard.
VITE_SUPABASE_ANON_KEY=

# Labelled "secret key" (or legacy "service_role key") in the dashboard.
# Server-only. Bypasses Row-Level Security, so it must never appear in client
# code. Verify with: npm run check:service-role
SUPABASE_SERVICE_ROLE_KEY=

# Private bucket holding uploaded verification documents.
SUPABASE_DOCUMENTS_BUCKET=documents

# ---------------------------------------------------------------------------
# telebirr (researcher deposits)
# ---------------------------------------------------------------------------
# All six are needed for live payment; they come from the Ethio Telecom merchant
# pack. TELEBIRR_PUBLIC_KEY is telebirr's (used to encrypt orders and verify their
# callbacks); TELEBIRR_PRIVATE_KEY is yours (used to sign orders). Either PEM or
# bare base64 works, on one line with \n or wrapped.
TELEBIRR_BASE_URL=
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_SHORT_CODE=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_PRIVATE_KEY=
TELEBIRR_RECEIVE_NAME=Ethosk
TELEBIRR_KEY_BITS=2048
TELEBIRR_TIMEOUT_MS=15000

# Public base URL telebirr posts payment results to. Must be reachable from the
# internet — in local development that means a tunnel (e.g. ngrok), because a
# callback that cannot arrive leaves every deposit stuck pending.
TELEBIRR_NOTIFY_BASE_URL=

# Simulates checkout locally when telebirr is unconfigured, so the funding flow is
# demoable. Set to false anywhere real money is involved: it credits a balance
# with no payment behind it.
ALLOW_TELEBIRR_DEMO=true

# Postgres connection string, used by `npm run migrate` and `npm run seed`.
#
# Prefer the pooler string over the direct db.<ref>.supabase.co one: the direct
# host is IPv6-only, so it is unreachable from a network without IPv6. Take the
# "Session pooler" string from Supabase -> Project Settings -> Database. It looks
# like the line below, where the username carries the project ref and the port is
# 5432 — transaction mode on 6543 cannot run schema changes.
#
# Percent-encode any reserved characters in the password (@ becomes %40).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# Both are optional: without them every AI feature falls back to its documented
# non-AI behaviour rather than failing.
ANTHROPIC_API_KEY=
ADDIS_AI_API_KEY=
ADDIS_AI_API_BASE_URL=https://api.addisai.com/v1

# ---------------------------------------------------------------------------
# Outgoing email (verification & password-reset codes)
# ---------------------------------------------------------------------------
# Without all three of SMTP_HOST/SMTP_USER/SMTP_PASS set, the 6-digit codes
# generated for signup verification, resend, and forgot-password are never
# actually emailed -- they only appear in the server log (development only)
# and in the API response as demo_code. Any standard SMTP provider works
# (e.g. Gmail app password, SendGrid, Mailgun, Amazon SES, Postmark).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ethosksupport@gmail.com
SMTP_PASS=zmduqegoupmditlo
SMTP_FROM=Ethosk <no-reply@ethosk.app>

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
API_PORT=4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Full URL of the backend API service (no trailing slash).
# Required in production when the frontend and backend are deployed as separate
# services (e.g. on Render).  Leave blank for local development — the Vite dev
# server proxy handles /api → localhost:$API_PORT instead.
# Example: VITE_API_URL=https://ethosk-backend.onrender.com
VITE_API_URL=

# Pepper mixed into the Fayda-ID hash. Set a long random value per environment;
# changing it invalidates existing duplicate detection.
NATIONAL_ID_PEPPER=

# ---------------------------------------------------------------------------
# Fayda (Ethiopian National ID) verification
# ---------------------------------------------------------------------------
# With both of these set, submitted FIN numbers are verified against the live
# Fayda service. Without them, verification is refused unless the demo fallback
# below is enabled.
FAYDA_API_BASE_URL=
FAYDA_API_KEY=
FAYDA_PARTNER_ID=
FAYDA_TIMEOUT_MS=10000

# Accepts a handful of seeded demo FIN numbers when Fayda is unconfigured, so the
# flow can be demonstrated without live credentials. Set to false anywhere real
# users can reach the app: it is a demo affordance, not an authentication path.
ALLOW_FAYDA_STUB=true

# ---------------------------------------------------------------------------
# verify.et (Transaction & Wallet Deposit Reconciliation)
# ---------------------------------------------------------------------------
# Server-only credentials for reconciling researcher deposits (CBE, Telebirr, BOA,
# Dashen, Awash, CBE Birr, Siinqee, Kaafi Ebirr) via the verify.et API.
VERIFY_ET_BASE_URL=https://api.verify.et/v1
VERIFY_ET_API_KEY=
VERIFY_ET_TIMEOUT_MS=10000

# When true, allows simulated responses for testing/demos without live credentials.
# In production, stubs are automatically disabled.
ALLOW_VERIFY_ET_STUB=false

# ---------------------------------------------------------------------------
# Response-quality thresholds
# ---------------------------------------------------------------------------
FRAUD_MIN_SECONDS_PER_QUESTION=8
FRAUD_STRAIGHT_LINE_THRESHOLD=0.7
# Free-text answers at or above this length are checked for typing speed and
# pasting; shorter answers carry no useful signal.
FRAUD_LONG_TEXT_MIN_CHARS=80
FRAUD_MAX_TYPING_CHARS_PER_SECOND=15
MATCH_POWER_WARNING_THRESHOLD=20
